;
; PadDisplay Microphone: a virtual microphone. PadDisplay.exe creates the root-enumerated device Root\PadDisplayMic
; (the same way it installs the virtual monitor) and the tablet's microphone audio appears as a recording device.
; padmic.inx is the template; build.cmd stamps the version, KMDF version and architecture into padmic.inf.

[Version]
Signature   = "$WINDOWS NT$"
Class       = MEDIA
ClassGuid   = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
DriverVer   = 01/01/2026,1.0.0.0
CatalogFile = padmic.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[Manufacturer]
%ProviderName% = Standard,NT$ARCH$.10.0...19041

[Standard.NT$ARCH$.10.0...19041]
%PadMic.DeviceDesc% = PadMic_Device, ROOT\PadDisplayMic

[PadMic_Device.NT]
CopyFiles = PadMic_Device.NT.Copy

[PadMic_Device.NT.Copy]
padmic.sys

[PadMic_Device.NT.Services]
AddService = padmic, %SPSVCINST_ASSOCSERVICE%, PadMic_Service_Inst

[PadMic_Service_Inst]
DisplayName   = %PadMic.DeviceDesc%
ServiceType   = 1   ; SERVICE_KERNEL_DRIVER
StartType     = 3   ; SERVICE_DEMAND_START
ErrorControl  = 1   ; SERVICE_ERROR_NORMAL
ServiceBinary = %13%\padmic.sys

[SourceDisksNames]
1 = %DiskId1%,,,""

[SourceDisksFiles]
padmic.sys = 1,,

[PadMic_Device.NT.Wdf]
KmdfService = padmic, PadMic_wdfsect

[PadMic_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

; The microphone endpoint: the interface names match the circuit name in the driver ("Microphone0").
[PadMic_Device.I.Microphone]
AddReg = PadMic_Device.I.Microphone.AddReg

[PadMic_Device.I.Microphone.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%PadMic.Microphone.szPname%
; Opt in to event-driven (pull) mode.
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

[PadMic_Device.NT.Interfaces]
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_Microphone%, PadMic_Device.I.Microphone
AddInterface = %KSCATEGORY_CAPTURE%,  %KSNAME_Microphone%, PadMic_Device.I.Microphone
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_Microphone%, PadMic_Device.I.Microphone

[Strings]
; Non-localizable
KSNAME_Microphone = "Microphone0"
SPSVCINST_ASSOCSERVICE = 0x00000002
ProviderName = "Nezucloud"

Proxy.CLSID                = "{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO           = "{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_CAPTURE         = "{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME        = "{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSNODETYPE_ANY             = "{00000000-0000-0000-0000-000000000000}"
PKEY_AudioEndpoint_Association                   = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
PKEY_AudioEndpoint_Supports_EventDriven_Mode     = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"

; Localizable
DiskId1 = "PadDisplay Microphone installation disk"
PadMic.DeviceDesc = "PadDisplay Virtual Microphone"
PadMic.Microphone.szPname = "PadDisplay Microphone"
